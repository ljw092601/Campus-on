<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch splash: white + full 동아메이트 wordmark logo.
     Android 12+ ignores this and shows the system splash (round emblem);
     the wordmark there lives in the in-app opening overlay (app.dart). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
