rules_version = '2';

// Campus-On MVP security model
// -----------------------------
// The app is BROWSE-ONLY and has NO login (plan.md §5). Content (facilities,
// guide items) is public read-only. Clients never write — content is seeded by
// the developer via the Admin SDK / console (tool/firestore_seed/), which
// bypasses these rules. Everything else is denied by default.
//
// Deploy:  firebase deploy --only firestore:rules
// Test:    firebase emulators:start   (or the Rules Playground in the console)

service cloud.firestore {
  match /databases/{database}/documents {

    // M-26: single-document `get` stays open, but every collection `list`
    // must carry an explicit `.limit()` no larger than the per-collection
    // cap. A query without `.limit()` has no `request.query.limit`, so the
    // comparison errors out and the read is denied — the app therefore
    // always passes a limit (lib/data/firestore/firestore_read.dart
    // `readQuery`, constants in FirestoreListLimits). Keep each cap here
    // >= the app constant; test/firestore_limits_test.dart cross-checks.
    function boundedList(max) {
      return request.query.limit <= max;
    }

    // Public campus facilities — anyone may read (list capped), nobody may write
    // from a client.
    match /facilities/{facilityId} {
      allow get: if true;
      allow list: if boundedList(500);
      allow write: if false;
    }

    // Public admin-guide items — same policy.
    match /guide_items/{itemId} {
      allow get: if true;
      allow list: if boundedList(200);
      allow write: if false;
    }

    // Public building floor guides (doc id == facility id) — same policy.
    match /building_floors/{facilityId} {
      allow get: if true;
      allow list: if boundedList(200);
      allow write: if false;
    }

    // Admin-entered content (design doc _workspace/06_admin_data_pipeline.md
    // §7): written only by the admin sheet sync via the Firestore REST API
    // with IAM auth, which bypasses these rules. Clients read-only.
    match /academic_events/{eventId} {
      allow get: if true;
      allow list: if boundedList(500);
      allow write: if false;
    }
    match /cafeterias/{cafeteriaId} {
      allow get: if true;
      allow list: if boundedList(50);
      allow write: if false;
    }
    match /dining_menus/{menuId} {
      allow get: if true;
      allow list: if boundedList(50);
      allow write: if false;
    }

    // Sync audit log (admin_sync_runs) stays private: it may carry editor
    // identities and error details. Covered by the default deny below —
    // do NOT add a public read rule for it.

    // Default deny for any collection not listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
